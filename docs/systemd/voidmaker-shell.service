[Unit]
Description=VoidMaker Quickshell interface
After=graphical-session.target voidmaker-host.service
PartOf=voidmaker.target
StopWhenUnneeded=yes
Wants=voidmaker-host.service

[Service]
Type=simple
WorkingDirectory=%h/dev/VoidMaker
ExecStart=/run/current-system/sw/bin/nix develop --command quickshell --path apps/shell/shell.qml
Restart=on-failure
RestartSec=3
