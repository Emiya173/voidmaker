[Unit]
Description=VoidMaker TypeScript assistant Host
Requires=voidmaker-postgres.service
After=voidmaker-postgres.service voidmaker-asr.service voidmaker-tts.service graphical-session.target
Wants=voidmaker-asr.service voidmaker-tts.service
PartOf=voidmaker.target
StopWhenUnneeded=yes

[Service]
Type=simple
WorkingDirectory=%h/dev/VoidMaker
Environment=PGHOST=%t/voidmaker-postgres
Environment=PGDATABASE=voidmaker
ExecStart=/run/current-system/sw/bin/nix develop --command node dist/apps/host/src/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
