{
  "name": "voidmaker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit && biome check apps packages tests",
    "test": "vitest run",
    "dev:host": "tsx apps/host/src/main.ts",
    "start:host": "node dist/apps/host/src/main.js",
    "db:migrate": "tsx apps/host/src/migrate.ts",
    "asr:evaluate": "tsx apps/tools/src/asr-evaluate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
