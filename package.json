{
  "name": "voidmaker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit && biome check apps packages tests",
    "test": "vitest run",
    "dev:host": "tsx apps/host/src/main.ts",
    "start:host": "node dist/apps/host/src/main.js",
    "db:migrate": "tsx apps/host/src/migrate.ts",
    "asr:evaluate": "tsx apps/tools/src/asr-evaluate.ts",
    "work:smoke": "tsx apps/tools/src/work-smoke.ts",
    "aec:smoke": "tsx apps/tools/src/aec-smoke.ts",
    "aec:replay": "tsx apps/tools/src/aec-replay.ts",
    "aec:session-smoke": "tsx apps/tools/src/aec-session-smoke.ts",
    "character:import": "tsx apps/tools/src/character-import.ts",
    "character:pmx": "tsx apps/tools/src/character-convert-pmx.ts",
    "character:roundtrip": "tsx apps/tools/src/character-roundtrip.ts",
    "character:inspect": "tsx apps/tools/src/character-inspect.ts",
    "voice:review": "tsx apps/tools/src/voice-review.ts"
  },
  "dependencies": {
    "dbus-next": "0.10.2",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "smol-toml": "1.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "fflate": "^0.8.3",
    "mmd-parser": "^1.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
